# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
.venv/
venv/
env/
ENV/

# Build artifacts & distributions
build/
dist/
*.egg-info/
*.egg

# Data, caches, checkpoints
/data/
/cache/
/save/
