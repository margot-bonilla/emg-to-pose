/external/
checkpoints/
*.h5
*.hdf5
*.npy
*.npz
*.tar.gz
*.zip

# PyTorch weights: only submission folders keep theirs (needed for the audit)
*.pt
*.pth
*.ckpt
!submission/weights*.pt
!submissions/*/weights*.pt

# Benchopt & competition cache
.benchopt/
results/
outputs/

# OS & Editor files
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Local, machine-specific configs and logs
*.local.json
/logs/
